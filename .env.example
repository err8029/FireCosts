# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_map_key_here

# Only needed if requests to FIRMS/Overpass/Catastro/Nominatim fail with
# "SSLError: ... certificate verify failed: unable to get local issuer
# certificate" -- usually means local antivirus/corporate-proxy HTTPS
# scanning is re-signing traffic with its own root certificate, which
# Windows trusts but Python's bundled certifi CA list doesn't. Fix: export
# that root cert (Windows cert store, under a name like "<vendor> Web/
# Mail Shield" or similar), append it to a copy of certifi's cacert.pem,
# and point this at the combined file. Leave unset if you don't hit this.
# REQUESTS_CA_BUNDLE=C:\path\to\cacert_with_local_root.pem

# Optional: how long (seconds) /api/estimate waits for OSM Overpass
# building/vegetation data, and /api/report waits for municipality/
# locator/vegetation-municipality lookups, before degrading gracefully
# instead of hanging. Some hosting environments (e.g. Render's free tier)
# have a slower/more rate-limited route to Overpass than a home
# connection, which can make vegetation data time out more often there --
# raise these if that happens, no code change/redeploy needed.
# ESTIMATE_FETCH_DEADLINE_S=45
# REPORT_LOOKUP_DEADLINE_S=25

# Optional: how long (seconds) a single Overpass tile request is allowed
# before it's abandoned (see overpass.fetch_tiled, used by both buildings
# and vegetation). Deliberately much shorter than ESTIMATE_FETCH_DEADLINE_S
# rather than reusing it -- an abandoned request keeps running in the
# background for as long as its own timeout allows (Python can't forcibly
# cancel in-flight blocking I/O), still occupying one of Overpass's
# limited per-client concurrent slots, so a short per-tile timeout matters
# for letting a stuck attempt die off quickly instead of still competing
# with your *next* retry.
# ESTIMATE_TILE_TIMEOUT_S=20

# Optional: max size (real km2, not the bounding box's raw degrees2 --
# those don't convert to a fixed real area) of the burnt-area *bounding
# box* /api/estimate will attempt a live building/vegetation lookup for.
# Past this, it skips the lookup outright (fires and the burnt-area
# estimate still come back fine, just without building/vegetation stats)
# instead of attempting -- and eventually failing -- a fetch covering an
# unrealistic amount of OSM data. Note this is the *bounding box* of the
# burnt area, not the burnt area's own footprint -- a sprawling/disjoint
# multi-day fire's bounding box can be several times bigger than its
# actual burnt km2 (confirmed directly: one real ~270km2 fire had a
# ~1826km2 bounding box), so it can hit this cap well before the burnt
# area itself looks anywhere near it.
# ESTIMATE_MAX_QUERY_BBOX_KM2=3000
